# Copy to `.env` at the repo root. Read by the Supabase CLI when it starts the local stack —
# `supabase/config.toml` refers to these by name. The web app does not see them.
# `.env` is gitignored; this file is the tracked template.

# --- Google OAuth ---------------------------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (application type: Web application).
#
# The authorized redirect URI must be Supabase's own callback, NOT Next's:
#
#   http://127.0.0.1:54321/auth/v1/callback
#
# Google redirects to Supabase, which then redirects to this app's /auth/callback route.
# Until both values are set, `supabase start` still comes up and email/password sign-in works;
# only the Google button returns a provider error.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
