# Copy to `apps/web/.env.local` and fill in from the output of `pnpm supabase start`.
# `.env.local` is gitignored; this file is the tracked template.

# --- Supabase (local defaults; `pnpm supabase status` prints the current values) ------------
# Compiled into the browser bundle by design. The anon key is a public key — every access
# decision it can make is enforced by the RLS policies in supabase/migrations/, not by keeping
# this string secret.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row-Level Security completely. Read in exactly one module —
# apps/web/src/features/auth/server/resolve-identifier.ts — which is marked `server-only`, so
# importing it from a client component is a build error rather than a leak. Never prefix this
# with NEXT_PUBLIC_, and never add a second reader without deciding it is worth the blast radius.
SUPABASE_SERVICE_ROLE_KEY=

# --- Attachment virus scanning ---------------------------------------------------------------
# SERVER ONLY. The `clamav-rest`-shaped endpoint every announcement attachment is posted to
# before it is stored. `docker compose up -d` at the repo root runs one on port 9000; the value
# below is that container.
#
# The scan FAILS CLOSED: with this unset, every attachment upload is refused. That is deliberate
# — an antivirus integration that passes files while the scanner is down is worse than none,
# because it is believed. See apps/web/src/features/announcements/server/scan.ts.
ANTIVIRUS_SCAN_URL=http://127.0.0.1:9000/scan

# LOCAL DEVELOPMENT ONLY. Set to `1` to accept attachments with no scanner running at all, so
# that the announcement board can be worked on without a signature database on your machine.
#
# It applies only when ANTIVIRUS_SCAN_URL is empty — it will not rescue a scanner that is failing
# — and it is ignored outright when NODE_ENV is `production`, so it cannot travel into a
# deployment. Leave it empty unless you are running `next dev` without the container.
ALLOW_UNSCANNED_UPLOADS=
