# Copy to `apps/web/.env.local` and fill in from the output of `pnpm supabase start`.
# `.env.local` is gitignored; this file is the tracked template.

# --- Supabase (local defaults; `pnpm supabase status` prints the current values) ------------
# Compiled into the browser bundle by design. The anon key is a public key — every access
# decision it can make is enforced by the RLS policies in supabase/migrations/, not by keeping
# this string secret.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row-Level Security completely. Read in exactly one module —
# apps/web/src/features/auth/server/resolve-identifier.ts — which is marked `server-only`, so
# importing it from a client component is a build error rather than a leak. Never prefix this
# with NEXT_PUBLIC_, and never add a second reader without deciding it is worth the blast radius.
SUPABASE_SERVICE_ROLE_KEY=
